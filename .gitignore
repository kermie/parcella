# Umgebungsvariablen (enthält Geheimnisse, niemals committen)
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Docker
*.log

# IDE
.idea/
.vscode/
*.swp

# Geany-Projektdateien (lokal, nicht relevant für andere Mitwirkende)
*.geany

# Betriebssystem
.DS_Store
Thumbs.db

# Claude Code worktrees (each has its own .git, never track as a subdirectory)
.claude/worktrees/

# Announcement images and user avatars are user-uploaded content (test or
# real), never repo assets -- unlike the default app/static/uploads/logo.png,
# which IS git-tracked on purpose. A past `git add -A` accidentally committed
# a pile of these from test runs; don't let that happen again.
app/static/uploads/announcements/
app/static/uploads/avatars/
